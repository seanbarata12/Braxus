{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "brax",
  "compatibility_date": "2026-09-01",
  // Small script that handles the quote form (POST /api/quote).
  // Everything else is served straight from ./public as before.
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Quote requests are emailed to Sean's Google Workspace inbox via
  // Cloudflare Email Service (Email Sending). braxusplumbing.com must be
  // onboarded under Email Service > Email Sending (records live on the
  // cf-bounce subdomain, so they don't clash with Google's MX records).
  // Email Routing is OFF on this domain: Google Workspace handles inbound mail.
  "send_email": [
    {
      "name": "QUOTE_EMAIL",
      "allowed_sender_addresses": ["quotes@braxusplumbing.com"],
      "allowed_destination_addresses": ["sean@braxusplumbing.com"]
    }
  ]
}
