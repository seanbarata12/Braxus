{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "brax",
  "compatibility_date": "2026-09-01",
  // Small script that handles the quote form (POST /api/quote).
  // Everything else is served straight from ./public as before.
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Quote requests are emailed to Sean's Google Workspace inbox for free
  // using Email Routing on the mail.braxusplumbing.com SUBDOMAIN (so it
  // doesn't clash with Google's MX records on braxusplumbing.com).
  // sean@braxusplumbing.com must be a verified destination address.
  "send_email": [
    { "name": "QUOTE_EMAIL", "destination_address": "sean@braxusplumbing.com" }
  ]
}
